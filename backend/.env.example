# ISU-GeoBot — backend configuration. Copy to server/.env. Never commit.

NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
SESSION_SALT=generate-a-long-random-string

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...           # verifies end-user JWTs only
# AUDIT W2: bypasses RLS. Server-side ONLY. Never in a VITE_* var, never in git.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DB_SCHEMA=geobot

# --- ML microservice (audit W7: loopback, never internet-reachable) --------
ML_BASE_URL=http://127.0.0.1:5001
ML_TIMEOUT_MS=8000

# --- Groq / Llama 3.1 8B (thesis §3.7) ------------------------------------
# Pin the model id and record it on every eval_run. If Groq retires it, the
# substitution must be DISCLOSED — every prior number becomes non-comparable.
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=700
GROQ_TIMEOUT_MS=30000

# --- Retrieval ------------------------------------------------------------
# AUDIT C19: K moves Context Precision and Context Recall in OPPOSITE
# directions. Fix it before evaluating, keep it identical across both arms,
# and never tune it after seeing RAGAS output.
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_FLOOR=0.25

# --- Presence -------------------------------------------------------------
CAMPUS_TIMEZONE=Asia/Manila

# --- Rate limiting (audit F-29: the aggregation-attack mitigation) --------
RATE_WINDOW_MS=60000
RATE_CHAT_MAX=15
RATE_DEMO_MAX=10
RATE_GENERAL_MAX=120
