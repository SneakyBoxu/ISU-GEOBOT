# Bind to loopback. ML service should not be exposed externally
ML_HOST=127.0.0.1
ML_PORT=5001

# MODEL_DIR intentionally unset: ai_api_service.py defaults to
# Path(__file__).parent/'saved-models', which is correct no matter
# which directory the service is launched from. A relative value
# here resolves against the CWD and silently finds nothing.
# MODEL_DIR=
RF_ARTIFACT=rf_current.joblib
EMBED_MODEL=all-MiniLM-L6-v2
