# ISU-GeoBot — ML service configuration
# Copy to ml/.env. NEVER commit the filled-in file.

# Supabase direct Postgres connection (Project Settings -> Database -> URI).
# This is a service-level credential (audit W2): server-side only.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DB_SCHEMA=geobot

# Bind to loopback. The ML service must NEVER be internet-reachable (audit W7):
# /predict exposes raw classifications and predict_proba.
ML_HOST=127.0.0.1
ML_PORT=5001

MODEL_DIR=./models
RF_ARTIFACT=rf_current.joblib
EMBED_MODEL=all-MiniLM-L6-v2
