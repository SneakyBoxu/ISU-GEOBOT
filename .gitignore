# =====================================================================
# ISU-GeoBot — Git Ignore Configuration
# =====================================================================

# 1. Dependency and build artifacts (auto-installed via npm / pip)
# Secrets. Never commit a live key.
# This rule keeps getting lost in merges; every time it does, the Supabase
# service_role key and the Groq key go public with the next push.
.env
.env.local

node_modules/
dist/
.venv/
venv/
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# 2. Intermediate model runs (track active production model only)
machine-learning/saved-models/*
!machine-learning/saved-models/.gitkeep

# 3. Thesis documents and generated study material.
#    These are write-ups and rendered artefacts, not the system. They bloated
#    every pull for the other researcher and none of them are needed to run,
#    build or evaluate anything. They stay on the authors' machines.
guide/
notebooks/
*.docx
*.pdf
CCSICT-SCHEDULE-*.xlsx
