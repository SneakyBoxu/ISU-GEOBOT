# ISU-GeoBot — frontend. Copy to web/.env
#
# AUDIT W2: only PUBLIC values belong here. Everything with VITE_ is compiled
# into the browser bundle and is readable by anyone. The Supabase service_role
# key and the Groq API key must NEVER appear in this file.

VITE_API_BASE=/api
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...        # anon key only — used for portal sign-in
